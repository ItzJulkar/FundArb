[Unit]
Description=SSH tunnel to poly CEX proxy :8790
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -i /root/.ssh/id_ed25519_fundarb -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -L 127.0.0.1:8790:127.0.0.1:8790 ubuntu@129.226.213.46
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
